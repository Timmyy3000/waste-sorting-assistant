# Copy to .env locally. Never put a real key in this example.
# This file points to a private key file OUTSIDE the repository.
OPENAI_API_KEY_FILE=/absolute/path/to/private/api-key.txt
# REPLACE: put your own API key in the file above (OpenAI, KI:connect NRW or Gemini).
# Optional: any OpenAI-compatible provider, e.g. https://chat.kiconnect.nrw/api/v1
# or https://generativelanguage.googleapis.com/v1beta/openai/ (Gemini)
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
# Optional offline image matcher; install weights outside Git first.
# LOCAL_VISION_MODEL_DIR=/absolute/path/to/local/vision/model
# Set a long random value in deployment to retain browser-owned corrections.
FLASK_SECRET_KEY=replace-with-a-long-random-server-secret
# No DB_HOST means local SQLite. Compose configures MySQL automatically.
