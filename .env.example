# Copy to .env locally. Never put a real key in this example.
# This file points to a private key file OUTSIDE the repository.
OPENAI_API_KEY_FILE=/absolute/path/to/private/api-key.txt
# Optional: any OpenAI-compatible provider, e.g. https://chat.kiconnect.nrw/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
# No DB_HOST means local SQLite. Compose configures MySQL automatically.
